{%- comment -%}
  ElevenLabs voice/chat pilot ("Llanos").
  Paste into layout/theme.liquid just before </body>, AFTER the old
  "Kuphuka Chat Widget" block. To revert: delete this whole block.

  Part 1 (every page): remembers the titles of the pages seen during this
  visit (sessionStorage, cleared when the tab closes; no personal data).

  Part 2 (only /products/kuphuka-greens):
  - The Bundle page is excluded on purpose: the agent's knowledge base has no
    Bundle pricing and would quote the single-tub prices.
  - Hides the old #kup-widget on this page so there is one chat bubble, not two.
    Everywhere else the old widget (and the Telegram takeover) is unchanged.
  - One launcher that looks like the old bubble. Clicking it offers
    "Escribir" or "Hablar"; the ElevenLabs widget stays hidden until the
    customer picks one, and hides again when the chat is closed or the call ends.
  - When the customer picks an option, the page sends Llanos the current
    flavour, the basket contents and the pages seen this visit.
  - Llanos can add the product to the basket (add_to_cart) and open checkout
    (go_to_checkout), only after the customer says yes.
  - It is driven through the widget's button labels ("Mensaje", "Iniciar llamada",
    "Contraer", "Finalizar"), which are set in the agent's widget texts: if those
    texts change, change them here too.
{%- endcomment -%}
<script>
  (function () {
    try {
      var key = 'kup_pages';
      var pages = JSON.parse(sessionStorage.getItem(key) || '[]');
      var title = document.title.split(/\s[|–-]\s/)[0].trim();
      if (title && pages[pages.length - 1] !== title) {
        pages.push(title);
        sessionStorage.setItem(key, JSON.stringify(pages.slice(-12)));
      }
    } catch (e) {}
  })();
</script>
{%- if template.name == 'product' and product.handle == 'kuphuka-greens' -%}
  <style>
    #kup-widget { display: none !important; }
    #kup-llanos { visibility: hidden; pointer-events: none; }
    #kup-llanos.kup-ll-active { visibility: visible; pointer-events: auto; }
    #kup-ll { position: fixed; bottom: 34px; right: 24px; z-index: 9999; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, sans-serif; }
    #kup-ll.kup-ll-hidden { display: none; }
    #kup-ll-btn { width: 56px; height: 56px; border-radius: 50%; background: transparent; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: transform 0.2s; margin-left: auto; padding: 0; }
    #kup-ll-btn:hover { transform: scale(1.07); }
    #kup-ll-btn svg { width: 52px; height: 52px; }
    #kup-ll-btn .kup-ll-close { display: none; }
    #kup-ll.kup-ll-open #kup-ll-btn .kup-ll-chat { display: none; }
    #kup-ll.kup-ll-open #kup-ll-btn .kup-ll-close { display: block; }
    #kup-ll-menu { display: none; width: 240px; background: #fff; border-radius: 16px; box-shadow: 0 12px 40px rgba(0,0,0,0.16), 0 0 0 1px rgba(0,0,0,0.04); padding: 14px; margin-bottom: 10px; }
    #kup-ll.kup-ll-open #kup-ll-menu { display: block; }
    #kup-ll-menu p { margin: 0 0 10px; font-size: 14px; font-weight: 600; color: #1a1a1a; }
    .kup-ll-opt { display: flex; align-items: center; gap: 12px; width: 100%; padding: 10px 12px; margin-top: 6px; border: 1px solid #e3ebe6; border-radius: 12px; background: #fff; cursor: pointer; text-align: left; font: inherit; transition: background 0.2s, border-color 0.2s; }
    .kup-ll-opt:hover { background: #f2f8f4; border-color: #2a7d4f; }
    .kup-ll-opt svg { width: 22px; height: 22px; flex-shrink: 0; }
    .kup-ll-opt strong { display: block; font-size: 14px; color: #1a1a1a; }
    .kup-ll-opt span { display: block; font-size: 12px; color: #6b6b6b; }
    @media (max-width: 420px) { #kup-ll { bottom: 80px; right: 16px; } }
  </style>

  <div id="kup-ll">
    <div id="kup-ll-menu">
      <p>¿Cómo prefieres hablar?</p>
      <button class="kup-ll-opt" data-mode="Mensaje">
        <svg viewBox="0 0 24 24" fill="none" stroke="#2a7d4f" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>
        <div><strong>Escribir</strong><span>Chatea por mensajes</span></div>
      </button>
      <button class="kup-ll-opt" data-mode="Iniciar llamada">
        <svg viewBox="0 0 24 24" fill="none" stroke="#2a7d4f" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>
        <div><strong>Hablar</strong><span>Conversación por voz</span></div>
      </button>
    </div>
    <button id="kup-ll-btn" aria-label="Abrir asistente Kuphuka">
      <svg class="kup-ll-chat" viewBox="0 0 24 24" fill="none" stroke="#2a7d4f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.37 5.07L2 22l4.93-1.37C8.42 21.5 10.15 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2z"/><text x="12" y="17.5" text-anchor="middle" font-size="14" font-family="Helvetica Neue, Helvetica, Arial, sans-serif" font-weight="300" fill="#2a7d4f" stroke="none">?</text></svg>
      <svg class="kup-ll-close" viewBox="0 0 24 24" fill="none" stroke="#2a7d4f" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <elevenlabs-convai id="kup-llanos" agent-id="agent_5301m5vpf2kce9h9c1myennz0cs1"></elevenlabs-convai>
  <script>
    (function () {
      var el = document.getElementById('kup-llanos');
      var launcher = document.getElementById('kup-ll');
      var PRODUCT = {{ product.title | json }};
      var VARIANTS = [
        {%- for v in product.variants -%}
          { id: {{ v.id }}, title: {{ v.title | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ];
      var PLAN_ID = {{ product.selling_plan_groups.first.selling_plans.first.id | json }};

      function norm(s) {
        return String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      }
      // Flavour currently selected in the product form (follows the customer's clicks).
      function currentVariant() {
        var input = document.querySelector('form[action*="/cart/add"] [name="id"]');
        var id = input && Number(input.value);
        return VARIANTS.filter(function (v) { return v.id === id; })[0] || VARIANTS[0];
      }
      function variantFor(flavour) {
        var f = norm(flavour);
        var match = VARIANTS.filter(function (v) {
          var t = norm(v.title);
          return t === f || t.split(' ')[0] === f.split(' ')[0];
        })[0];
        return match || currentVariant();
      }
      function describeCart(cart) {
        if (!cart.items.length) return 'vacía';
        return cart.items.map(function (i) {
          var plan = i.selling_plan_allocation ? 'suscripción mensual' : 'compra única';
          return i.quantity + ' x ' + i.product_title + ' (' + i.variant_title + ', ' + plan + ')';
        }).join('; ');
      }
      function pagesViewed() {
        try {
          var pages = JSON.parse(sessionStorage.getItem('kup_pages') || '[]');
          return pages.length ? pages.join(' > ') : 'solo esta página';
        } catch (e) { return 'desconocido'; }
      }
      function getCart() {
        return fetch('/cart.js', { headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); });
      }
      // Context Llanos gets at the start of each conversation.
      function setContext() {
        return getCart().catch(function () { return null; }).then(function (cart) {
          el.setAttribute('dynamic-variables', JSON.stringify({
            page_type: 'product',
            product_name: PRODUCT,
            flavour: currentVariant().title.toLowerCase(),
            cart_count: cart ? cart.item_count : 0,
            cart_summary: cart ? describeCart(cart) : 'desconocida',
            pages_viewed: pagesViewed()
          }));
        });
      }
      setContext();

      // Re-render the theme's header (basket count) and basket drawer after a change.
      function refreshThemeCart(sections) {
        Object.keys(sections || {}).forEach(function (id) {
          var target = document.getElementById('shopify-section-' + id);
          if (!target || !sections[id]) return;
          var html = new DOMParser().parseFromString(sections[id], 'text/html');
          var fresh = html.getElementById('shopify-section-' + id);
          if (fresh) target.innerHTML = fresh.innerHTML;
        });
      }
      function cartSectionIds() {
        return Array.prototype.map.call(
          document.querySelectorAll('[id^="shopify-section-"]'),
          function (s) { return s.id.replace('shopify-section-', ''); }
        ).filter(function (id) { return /__(header|cart-drawer)$/.test(id); });
      }

      var clientTools = {
        add_to_cart: function (p) {
          var variant = variantFor(p && p.flavour);
          var subscription = !(p && p.plan === 'compra_unica');
          var item = { id: variant.id, quantity: Math.max(1, Number(p && p.quantity) || 1) };
          if (subscription && PLAN_ID) item.selling_plan = PLAN_ID;
          return fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items: [item], sections: cartSectionIds().join(',') })
          }).then(function (r) {
            return r.json().then(function (data) {
              if (!r.ok) throw new Error(data.description || data.message || 'error');
              refreshThemeCart(data.sections);
              return getCart();
            });
          }).then(function (cart) {
            return 'Añadido: ' + item.quantity + ' x ' + PRODUCT + ' (' + variant.title + ', ' +
              (subscription ? 'suscripción mensual' : 'compra única') + '). Cesta ahora: ' + describeCart(cart) + '.';
          }).catch(function (e) {
            return 'ERROR: no se pudo añadir a la cesta (' + e.message + ').';
          });
        },
        go_to_checkout: function () {
          setTimeout(function () { window.location.href = '/checkout'; }, 3500);
          return 'Abriendo el pago.';
        }
      };
      el.addEventListener('elevenlabs-convai:call', function (e) {
        e.detail.config.clientTools = clientTools;
      });

      function widgetButton(label) {
        return el.shadowRoot && el.shadowRoot.querySelector('button[aria-label="' + label + '"]');
      }
      // The ElevenLabs widget is shown only while a chat is open or a call is live.
      function sync() {
        var active = !!(widgetButton('Contraer') || widgetButton('Finalizar'));
        el.classList.toggle('kup-ll-active', active);
        launcher.classList.toggle('kup-ll-hidden', active);
        if (active) launcher.classList.remove('kup-ll-open');
      }
      var watching = false;
      function watch() {
        if (watching || !el.shadowRoot) return;
        watching = true;
        // iPhone zooms into text boxes smaller than 16px; keep the chat box at 16px.
        var style = document.createElement('style');
        style.textContent = 'textarea, input { font-size: 16px !important; }';
        el.shadowRoot.appendChild(style);
        new MutationObserver(sync).observe(el.shadowRoot, { childList: true, subtree: true, attributes: true });
        // Closing the window during a voice call ends the call, so the page is
        // never left with the call bar on top of it.
        el.shadowRoot.addEventListener('click', function (e) {
          var b = e.target.closest && e.target.closest('button');
          if (!b || b.getAttribute('aria-label') !== 'Contraer') return;
          setTimeout(function () {
            var end = widgetButton('Finalizar');
            if (end) end.click();
          }, 150);
        }, true);
      }

      document.getElementById('kup-ll-btn').addEventListener('click', function () {
        launcher.classList.toggle('kup-ll-open');
      });
      launcher.querySelectorAll('.kup-ll-opt').forEach(function (opt) {
        opt.addEventListener('click', function () {
          var tries = 0;
          setContext().then(function open() {
            // The widget script loads async: if it isn't ready yet, retry for ~3 s.
            var target = widgetButton(opt.getAttribute('data-mode'));
            if (!target) { if (++tries < 15) setTimeout(open, 200); return; }
            watch();
            target.click();
            sync();
          });
        });
      });
    })();
  </script>
  <script src="https://unpkg.com/@elevenlabs/convai-widget-embed" async type="text/javascript"></script>
{%- endif -%}
