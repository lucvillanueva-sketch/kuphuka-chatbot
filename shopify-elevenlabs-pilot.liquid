{%- comment -%}
  ElevenLabs voice/chat pilot ("Llanos").
  Paste into layout/theme.liquid just before </body>, AFTER the old
  "Kuphuka Chat Widget" block. To revert: delete this whole block.

  Part 1 (every page): remembers the titles of the pages seen during this
  visit (sessionStorage, cleared when the tab closes; no personal data).

  Part 2 (homepage, /products/kuphuka-greens, /pages/ingredientes and
  /pages/tabla-de-ingredientes-activos):
  - The Bundle page is excluded on purpose: the agent's knowledge base has no
    Bundle pricing and would quote the single-tub prices.
  - Hides the old #kup-widget on these pages so there is one chat bubble, not two.
    Everywhere else the old widget (and the Telegram takeover) is unchanged.
  - One small labelled launcher ("Asesora / Kuphuka"). Clicking it offers
    "Escribir" or "Hablar"; the ElevenLabs widget stays hidden until the
    customer picks one, and hides again when the chat is closed or the call ends.
  - Once per visit a short prompt appears next to it. Never over another popup.
    Its opening line is passed to Llanos (agent allows first_message override).
      Product page: after a click on the plan box, or after 30 s.
      Homepage: after 10 s.
      Ingredients pages: once the visitor has scrolled 75% of the page.
      Any page with something in the basket: after 8 s.
  - Orders are marked with the cart attribute "Asesora Llanos" ("conversación"
    or "añadió a la cesta"), visible in the order's Additional details.
  - When the customer picks an option, the page sends Llanos the current
    flavour, the basket contents and the pages seen this visit.
  - Llanos can add the product to the basket (add_to_cart) and open checkout
    (go_to_checkout), only after the customer says yes.
  - It is driven through the widget's button labels ("Mensaje", "Iniciar llamada",
    "Contraer", "Finalizar"), which are set in the agent's widget texts: if those
    texts change, change them here too.
{%- endcomment -%}
<script>
  (function () {
    try {
      var key = 'kup_pages';
      var pages = JSON.parse(sessionStorage.getItem(key) || '[]');
      var title = document.title.split(/\s[|–-]\s/)[0].trim();
      if (title && pages[pages.length - 1] !== title) {
        pages.push(title);
        sessionStorage.setItem(key, JSON.stringify(pages.slice(-12)));
      }
    } catch (e) {}
  })();
</script>
{%- assign kup_page = '' -%}
{%- if template.name == 'product' and product.handle == 'kuphuka-greens' -%}
  {%- assign kup_page = 'product' -%}
{%- elsif template.name == 'index' -%}
  {%- assign kup_page = 'home' -%}
{%- elsif template.name == 'page' -%}
  {%- if page.handle == 'ingredientes' or page.handle == 'tabla-de-ingredientes-activos' -%}
    {%- assign kup_page = 'ingredients' -%}
  {%- endif -%}
{%- endif -%}
{%- if kup_page != '' -%}
  {%- assign kup_product = all_products['kuphuka-greens'] -%}
  <style>
    #kup-widget { display: none !important; }
    #kup-llanos { visibility: hidden; pointer-events: none; }
    #kup-llanos.kup-ll-active { visibility: visible; pointer-events: auto; }
    #kup-ll { position: fixed; bottom: 34px; right: 24px; z-index: 9999; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, sans-serif; }
    #kup-ll.kup-ll-hidden { display: none; }
    #kup-ll-btn { display: flex; align-items: center; gap: 8px; width: max-content; white-space: nowrap; margin-left: auto; padding: 4px 12px 4px 4px; background: #fff; border: 1.5px solid #2a7d4f; border-radius: 999px; box-shadow: 0 4px 14px rgba(0,0,0,0.12); cursor: pointer; font: inherit; transition: transform 0.2s, box-shadow 0.2s; }
    #kup-ll-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(0,0,0,0.16); }
    .kup-ll-ico { width: 30px; height: 30px; border-radius: 50%; background: #2a7d4f; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .kup-ll-ico svg { width: 16px; height: 16px; }
    .kup-ll-ico .kup-ll-close { display: none; }
    #kup-ll.kup-ll-open .kup-ll-ico .kup-ll-chat { display: none; }
    #kup-ll.kup-ll-open .kup-ll-ico .kup-ll-close { display: block; }
    .kup-ll-txt { text-align: left; line-height: 1.15; }
    .kup-ll-txt strong { display: block; font-size: 12px; font-weight: 600; color: #1a1a1a; }
    .kup-ll-txt small { display: block; font-size: 12px; font-weight: 600; color: #2a7d4f; }
    #kup-ll-tease { display: none; position: relative; max-width: 250px; margin: 0 0 10px auto; padding: 12px 34px 12px 14px; background: #fff; border-radius: 14px; box-shadow: 0 10px 32px rgba(0,0,0,0.16), 0 0 0 1px rgba(0,0,0,0.04); font-size: 14px; color: #1a1a1a; cursor: pointer; }
    #kup-ll.kup-ll-teasing #kup-ll-tease { display: block; }
    #kup-ll.kup-ll-open #kup-ll-tease { display: none; }
    #kup-ll-tease-x { position: absolute; top: 6px; right: 6px; width: 24px; height: 24px; border: none; background: transparent; color: #8a8a8a; font-size: 18px; line-height: 1; cursor: pointer; }
    #kup-ll-menu { display: none; width: 240px; background: #fff; border-radius: 16px; box-shadow: 0 12px 40px rgba(0,0,0,0.16), 0 0 0 1px rgba(0,0,0,0.04); padding: 14px; margin-bottom: 10px; }
    #kup-ll.kup-ll-open #kup-ll-menu { display: block; }
    #kup-ll-menu p { margin: 0 0 10px; font-size: 14px; font-weight: 600; color: #1a1a1a; }
    .kup-ll-opt { display: flex; align-items: center; gap: 12px; width: 100%; padding: 10px 12px; margin-top: 6px; border: 1px solid #e3ebe6; border-radius: 12px; background: #fff; cursor: pointer; text-align: left; font: inherit; transition: background 0.2s, border-color 0.2s; }
    .kup-ll-opt:hover { background: #f2f8f4; border-color: #2a7d4f; }
    .kup-ll-opt svg { width: 22px; height: 22px; flex-shrink: 0; }
    .kup-ll-opt strong { display: block; font-size: 14px; color: #1a1a1a; }
    .kup-ll-opt span { display: block; font-size: 12px; color: #6b6b6b; }
    @media (max-width: 420px) {
      #kup-ll { bottom: 80px; right: 16px; }
    }
  </style>

  <div id="kup-ll">
    <div id="kup-ll-menu">
      <p>¿Cómo prefieres hablar?</p>
      <button class="kup-ll-opt" data-mode="Mensaje">
        <svg viewBox="0 0 24 24" fill="none" stroke="#2a7d4f" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>
        <div><strong>Escribir</strong><span>Chatea por mensajes</span></div>
      </button>
      <button class="kup-ll-opt" data-mode="Iniciar llamada">
        <svg viewBox="0 0 24 24" fill="none" stroke="#2a7d4f" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>
        <div><strong>Hablar</strong><span>Conversación por voz</span></div>
      </button>
    </div>
    <div id="kup-ll-tease" role="button" tabindex="0"><span id="kup-ll-tease-txt"></span><button id="kup-ll-tease-x" aria-label="Cerrar">×</button></div>
    <button id="kup-ll-btn" aria-label="Abrir la asesora Kuphuka">
      <span class="kup-ll-ico">
        <svg class="kup-ll-chat" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>
        <svg class="kup-ll-close" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </span>
      <span class="kup-ll-txt"><strong>Asesora</strong><small>Kuphuka</small></span>
    </button>
  </div>

  <elevenlabs-convai id="kup-llanos" agent-id="agent_5301m5vpf2kce9h9c1myennz0cs1"></elevenlabs-convai>
  <script>
    (function () {
      var el = document.getElementById('kup-llanos');
      var launcher = document.getElementById('kup-ll');
      var PAGE = {{ kup_page | json }}; // 'product', 'home' or 'ingredients'
      var PRODUCT = {{ kup_product.title | json }};
      var VARIANTS = [
        {%- for v in kup_product.variants -%}
          { id: {{ v.id }}, title: {{ v.title | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ];
      var PLAN_ID = {{ kup_product.selling_plan_groups.first.selling_plans.first.id | json }};

      function norm(s) {
        return String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      }
      // Flavour currently selected in the product form (follows the customer's clicks).
      // Only the product page has a flavour picker; elsewhere nothing is chosen yet.
      function currentVariant() {
        if (PAGE !== 'product') return null;
        var input = document.querySelector('form[action*="/cart/add"] [name="id"]');
        var id = input && Number(input.value);
        return VARIANTS.filter(function (v) { return v.id === id; })[0] || VARIANTS[0];
      }
      function variantFor(flavour) {
        var f = norm(flavour);
        var match = VARIANTS.filter(function (v) {
          var t = norm(v.title);
          return t === f || t.split(' ')[0] === f.split(' ')[0];
        })[0];
        return match || currentVariant() || VARIANTS[0];
      }
      function describeCart(cart) {
        if (!cart.items.length) return 'vacía';
        return cart.items.map(function (i) {
          var plan = i.selling_plan_allocation ? 'suscripción mensual' : 'compra única';
          return i.quantity + ' x ' + i.product_title + ' (' + i.variant_title + ', ' + plan + ')';
        }).join('; ');
      }
      function pagesViewed() {
        try {
          var pages = JSON.parse(sessionStorage.getItem('kup_pages') || '[]');
          return pages.length ? pages.join(' > ') : 'solo esta página';
        } catch (e) { return 'desconocido'; }
      }
      function getCart() {
        return fetch('/cart.js', { headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); });
      }
      // Opening question, matched to the one-time prompt the customer clicked (if any).
      var OPENINGS = {
        plan: '¿Te ayudo a elegir entre la suscripción y la compra única?',
        cart: '¿Te resuelvo alguna duda antes de pagar?',
        home: '¿Quieres que te cuente en un minuto qué es Kuphuka Greens?',
        ingredients: '¿Tienes alguna duda sobre los ingredientes?',
        general: '¿En qué te puedo ayudar?'
      };
      // Without a prompt, the product page uses the agent's own greeting (it names the flavour).
      var openingKey = PAGE === 'product' ? null : 'general';

      // Marks the order in Shopify (cart attribute, shown in the order's
      // "Additional details") so orders helped by Llanos can be counted.
      var TAG = 'Asesora Llanos';
      function tagOrder(value, cart) {
        // Same label in Microsoft Clarity, so these visits can be filtered there.
        try { if (window.clarity) { window.clarity('set', 'asesora_llanos', value); window.clarity('event', 'llanos_' + (value === 'conversación' ? 'conversacion' : 'cesta')); } } catch (e) {}
        if (cart && cart.attributes && cart.attributes[TAG] === 'añadió a la cesta') return;
        var attributes = {};
        attributes[TAG] = value;
        fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ attributes: attributes })
        }).catch(function () {});
      }

      // Context Llanos gets at the start of each conversation.
      function setContext() {
        return getCart().catch(function () { return null; }).then(function (cart) {
          el.setAttribute('dynamic-variables', JSON.stringify({
            page_type: PAGE,
            product_name: PRODUCT,
            flavour: currentVariant() ? currentVariant().title.toLowerCase() : 'ninguno todavía',
            cart_count: cart ? cart.item_count : 0,
            cart_summary: cart ? describeCart(cart) : 'desconocida',
            pages_viewed: pagesViewed()
          }));
          if (OPENINGS[openingKey]) el.setAttribute('override-first-message', '[warmly] ¡Hola! Soy Llanos, de Kuphuka. ' + OPENINGS[openingKey]);
          else el.removeAttribute('override-first-message');
          return cart;
        });
      }
      setContext();

      // Re-render the theme's header (basket count) and basket drawer after a change.
      function refreshThemeCart(sections) {
        Object.keys(sections || {}).forEach(function (id) {
          var target = document.getElementById('shopify-section-' + id);
          if (!target || !sections[id]) return;
          var html = new DOMParser().parseFromString(sections[id], 'text/html');
          var fresh = html.getElementById('shopify-section-' + id);
          if (fresh) target.innerHTML = fresh.innerHTML;
        });
      }
      function cartSectionIds() {
        return Array.prototype.map.call(
          document.querySelectorAll('[id^="shopify-section-"]'),
          function (s) { return s.id.replace('shopify-section-', ''); }
        ).filter(function (id) { return /__(header|cart-drawer)$/.test(id); });
      }

      var clientTools = {
        add_to_cart: function (p) {
          // Off the product page no flavour is picked: never guess one.
          if (PAGE !== 'product' && !(p && p.flavour)) {
            return Promise.resolve('FALTA_SABOR: no se ha añadido nada. Pregunta al cliente qué sabor prefiere (piña y coco o manzana y vainilla).');
          }
          var variant = variantFor(p && p.flavour);
          var subscription = !(p && p.plan === 'compra_unica');
          var item = { id: variant.id, quantity: Math.max(1, Number(p && p.quantity) || 1) };
          if (subscription && PLAN_ID) item.selling_plan = PLAN_ID;
          return fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items: [item], sections: cartSectionIds().join(',') })
          }).then(function (r) {
            return r.json().then(function (data) {
              if (!r.ok) throw new Error(data.description || data.message || 'error');
              refreshThemeCart(data.sections);
              tagOrder('añadió a la cesta');
              return getCart();
            });
          }).then(function (cart) {
            return 'Añadido: ' + item.quantity + ' x ' + PRODUCT + ' (' + variant.title + ', ' +
              (subscription ? 'suscripción mensual' : 'compra única') + '). Cesta ahora: ' + describeCart(cart) + '.';
          }).catch(function (e) {
            return 'ERROR: no se pudo añadir a la cesta (' + e.message + ').';
          });
        },
        go_to_checkout: function () {
          setTimeout(function () { window.location.href = '/checkout'; }, 3500);
          return 'Abriendo el pago.';
        }
      };
      el.addEventListener('elevenlabs-convai:call', function (e) {
        e.detail.config.clientTools = clientTools;
      });

      function widgetButton(label) {
        return el.shadowRoot && el.shadowRoot.querySelector('button[aria-label="' + label + '"]');
      }
      // The ElevenLabs widget is shown only while a chat is open or a call is live.
      function sync() {
        var active = !!(widgetButton('Contraer') || widgetButton('Finalizar'));
        el.classList.toggle('kup-ll-active', active);
        launcher.classList.toggle('kup-ll-hidden', active);
        if (active) launcher.classList.remove('kup-ll-open');
      }
      // The "Mmm..." pause filler is meant for voice; remove it from written chat.
      var mode = null;
      function stripFiller() {
        if (mode !== 'Mensaje' || !el.shadowRoot) return;
        var walker = document.createTreeWalker(el.shadowRoot, NodeFilter.SHOW_TEXT);
        var node;
        while ((node = walker.nextNode())) {
          if (/^\s*Mmm\.\.\.\s*/.test(node.nodeValue)) node.nodeValue = node.nodeValue.replace(/^\s*Mmm\.\.\.\s*/, '');
        }
      }
      var watching = false;
      function watch() {
        if (watching || !el.shadowRoot) return;
        watching = true;
        // iPhone zooms into text boxes smaller than 16px; keep the chat box at 16px.
        var style = document.createElement('style');
        style.textContent = 'textarea, input { font-size: 16px !important; }';
        el.shadowRoot.appendChild(style);
        new MutationObserver(function () { sync(); stripFiller(); })
          .observe(el.shadowRoot, { childList: true, subtree: true, attributes: true });
        // Closing the window during a voice call ends the call, so the page is
        // never left with the call bar on top of it.
        el.shadowRoot.addEventListener('click', function (e) {
          var b = e.target.closest && e.target.closest('button');
          if (!b || b.getAttribute('aria-label') !== 'Contraer') return;
          setTimeout(function () {
            var end = widgetButton('Finalizar');
            if (end) end.click();
          }, 150);
        }, true);
      }

      document.getElementById('kup-ll-btn').addEventListener('click', function () {
        launcher.classList.toggle('kup-ll-open');
        stopTeasing();
      });
      launcher.querySelectorAll('.kup-ll-opt').forEach(function (opt) {
        opt.addEventListener('click', function () {
          var tries = 0;
          mode = opt.getAttribute('data-mode');
          setContext().then(function (cart) {
            tagOrder('conversación', cart);
            (function open() {
              // The widget script loads async: if it isn't ready yet, retry for ~3 s.
              var target = widgetButton(mode);
              if (!target) { if (++tries < 15) setTimeout(open, 200); return; }
              watch();
              target.click();
              sync();
            })();
          });
        });
      });

      // One-time prompt next to the button, at a moment of doubt. Shown at most
      // once per visit, never over another popup (e.g. the Klaviyo welcome form).
      var TEASES = {
        plan: '¿Dudas entre suscripción o compra única? Te lo explico en un momento.',
        cart: '¿Alguna duda antes de pagar? Te ayudo.',
        time: '¿Te ayudo a elegir sabor o plan?',
        home: '¿Primera vez por aquí? Te cuento en un minuto qué es Kuphuka.',
        ingredients: '¿Dudas sobre algún ingrediente? Pregúntame.'
      };
      var DEFAULT_OPENING = openingKey;
      var teaseTimers = [];
      function alreadyTeased() {
        try { return sessionStorage.getItem('kup_teased') === '1'; } catch (e) { return true; }
      }
      function popupOpen() {
        return Array.prototype.some.call(document.querySelectorAll('[aria-modal="true"], [role="dialog"]'), function (d) {
          return d.offsetParent !== null && !launcher.contains(d);
        });
      }
      function tease(key) {
        if (alreadyTeased() || launcher.classList.contains('kup-ll-open') || el.classList.contains('kup-ll-active')) return;
        if (popupOpen()) { teaseTimers.push(setTimeout(function () { tease(key); }, 5000)); return; }
        try { sessionStorage.setItem('kup_teased', '1'); } catch (e) {}
        openingKey = key === 'time' ? DEFAULT_OPENING : key;
        document.getElementById('kup-ll-tease-txt').textContent = TEASES[key];
        launcher.classList.add('kup-ll-teasing');
        teaseTimers.forEach(clearTimeout);
        // Hide it again after 12 s so it never sits over the page's own buttons for long.
        teaseTimers = [setTimeout(stopTeasing, 12000)];
      }
      function stopTeasing() {
        launcher.classList.remove('kup-ll-teasing');
        teaseTimers.forEach(clearTimeout);
      }
      document.getElementById('kup-ll-tease').addEventListener('click', function (e) {
        if (e.target.id === 'kup-ll-tease-x') { openingKey = DEFAULT_OPENING; stopTeasing(); return; }
        stopTeasing();
        launcher.classList.add('kup-ll-open');
      });
      if (!alreadyTeased()) {
        getCart().then(function (cart) {
          if (cart.item_count > 0) teaseTimers.push(setTimeout(function () { tease('cart'); }, 8000));
          else if (PAGE === 'product') teaseTimers.push(setTimeout(function () { tease('time'); }, 30000));
          else if (PAGE === 'home') teaseTimers.push(setTimeout(function () { tease('home'); }, 10000));
        }).catch(function () {});
        if (PAGE === 'product') {
          document.addEventListener('click', function (e) {
            var box = e.target.closest && e.target.closest('.kp-buy-box, selling-plan-selector');
            if (!box || e.target.closest('button[type="submit"], [name="add"]')) return;
            teaseTimers.push(setTimeout(function () { tease('plan'); }, 1500));
          });
        }
        if (PAGE === 'ingredients') {
          // People read these pages to the end: wait until they are 75% down.
          window.addEventListener('scroll', function onScroll() {
            var seen = (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight;
            if (seen < 0.75) return;
            window.removeEventListener('scroll', onScroll);
            tease('ingredients');
          }, { passive: true });
        }
      }
    })();
  </script>
  <script src="https://unpkg.com/@elevenlabs/convai-widget-embed" async type="text/javascript"></script>
{%- endif -%}
